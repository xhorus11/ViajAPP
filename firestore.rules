rules_version = '2';

// Reglas de seguridad de Viajapp (Firestore).
// - Cada viaje compartido es un documento en /trips/{tripId}.
// - Solo los miembros (members = lista de UIDs) leen y escriben sus datos.
// - Para unirse hace falta conocer el ID del viaje (enlace / QR de invitación):
//   el usuario solo puede agregarse a sí mismo a "members".

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isMember(tripId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.members;
    }

    match /trips/{tripId} {
      // Leer un viaje concreto (necesario para unirse con el enlace)
      allow get: if signedIn();
      // Listar solo los viajes donde soy miembro
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      // Crear: quien lo crea queda como único miembro
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      // Editar: miembros; o alguien que se agrega a sí mismo (unirse)
      allow update: if signedIn() && (
        request.auth.uid in resource.data.members ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names']) &&
          request.resource.data.members.hasAll(resource.data.members) &&
          request.resource.data.members.removeAll(resource.data.members) == [request.auth.uid]
        )
      );
      allow delete: if signedIn() && request.auth.uid in resource.data.members;

      // Subcolecciones: lista del súper, gastos, fotos, agenda, recetas...
      match /{sub}/{docId} {
        allow read, write: if isMember(tripId);
      }
    }
  }
}
